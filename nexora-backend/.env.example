# App connection: a NON-superuser role, so Row-Level Security is enforced.
DATABASE_URL=postgresql+psycopg://nexora_app:nexora_app@localhost:5432/nexora
# Admin connection: used only by `python -m scripts.init_db` (tables, RLS, seed).
DATABASE_ADMIN_URL=postgresql+psycopg://nexora:nexora@localhost:5432/nexora

SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=120
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
